<%- include('../partials/header', { title: 'Organisations' }) %>
<%- include('../partials/app-shell-start', { currentPage: 'organizations', pageTitle: 'Organisations', pageDescription: 'Plans, contrats et accès des organisations' }) %>
<section class="page-intro"><div><h2>Gestion des organisations</h2><p>Supervisez les comptes clients, leur activité et leurs droits commerciaux.</p></div><span class="badge badge-blue"><%= organizations.filter(o => !o.deleted_at).length %> organisation(s)</span></section>
<% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %><% if (success) { %><div class="alert alert-success" role="status"><%= success %></div><% } %>
<section class="panel"><div class="panel-header"><div><h3>Organisations actives et suspendues</h3><p>Les éléments archivés ne sont pas affichés.</p></div></div><div class="table-wrap"><table class="data-table"><thead><tr><th>Organisation</th><th>Plan</th><th>Activité</th><th>Statut et contrat</th><th class="align-right">Actions</th></tr></thead><tbody>
<% organizations.filter(o => !o.deleted_at).forEach(org => { %><tr>
    <td><div class="cell-title"><%= org.name %></div><div class="cell-subtitle">#<%= org.org_id %> · créée le <%= new Date(org.created_at).toLocaleDateString('fr-FR') %></div></td>
    <td><span class="badge badge-blue"><%= org.plan?.title || 'DISCOVERY' %></span><% if (org.subscription_expires_at) { %><div class="cell-subtitle">Expire le <%= new Date(org.subscription_expires_at).toLocaleDateString('fr-FR') %></div><% } %></td>
    <td><span class="badge badge-slate"><%= org._count.usersQ %> utilisateur(s)</span> <span class="badge badge-purple"><%= org._count.events %> événement(s)</span></td>
    <td><span class="badge <%= org.is_active ? 'badge-green' : 'badge-amber' %>"><%= org.is_active ? 'Active' : 'Désactivée' %></span>
        <details class="enterprise-details"><summary>Configurer le contrat Entreprise</summary><form action="/organizations/<%= org.org_id %>/enterprise" method="POST" class="enterprise-form">
            <label class="field-label full">Référence du contrat<input name="contractReference" required maxlength="120" placeholder="ENT-2026-001" class="field-input"></label>
            <label class="field-label">Date de début<input type="date" name="startsAt" class="field-input"></label><label class="field-label">Date de fin<input type="date" name="endsAt" required class="field-input"></label>
            <label class="field-label">Événements / cycle<input type="number" min="0" name="maxEventsPerCycle" placeholder="Illimité" class="field-input"></label><label class="field-label">QR / événement<input type="number" min="0" name="maxQrCodesPerEvent" placeholder="Illimité" class="field-input"></label>
            <label class="field-label">Agents<input type="number" min="0" name="maxAgents" placeholder="Illimité" class="field-input"></label><label class="field-label">Zones<input type="number" min="0" name="maxAreas" placeholder="Illimité" class="field-input"></label>
            <button type="submit" class="primary-button full" onclick="return confirm('Activer ce contrat Entreprise ?')">Activer le contrat</button>
        </form></details>
    </td>
    <td class="align-right"><div class="action-row"><% if (org.is_active) { %><form action="/organizations/<%= org.org_id %>/deactivate" method="POST"><button class="action-button warning" onclick="return confirm('Désactiver cette organisation et ses utilisateurs ?')">Désactiver</button></form><% } else { %><form action="/organizations/<%= org.org_id %>/activate" method="POST"><button class="action-button success">Réactiver</button></form><form action="/organizations/<%= org.org_id %>/archive" method="POST"><button class="action-button danger" onclick="return confirm('Archiver cette organisation et ses utilisateurs ?')">Archiver</button></form><% } %></div></td>
</tr><% }) %>
<% if (!organizations.some(o => !o.deleted_at)) { %><tr><td colspan="5" class="empty-state">Aucune organisation à afficher.</td></tr><% } %>
</tbody></table></div></section>
<%- include('../partials/app-shell-end') %><%- include('../partials/footer') %>
