<%- include('partials/header', { title: 'Tableau de bord' }) %>
<%- include('partials/app-shell-start', { currentPage: 'dashboard', pageTitle: 'Tableau de bord', pageDescription: 'Vue d’ensemble de la plateforme AccessQ' }) %>
<section class="page-intro"><div><h2>Bonjour, administrateur</h2><p>Suivez l’adoption d’AccessQ et accédez rapidement à la gestion des organisations.</p></div></section>
<% if (locals.error) { %><div class="alert alert-error"><%= error %></div><% } %>
<section class="stats-grid" aria-label="Indicateurs principaux">
    <article class="stat-card" style="--tint:#eff6ff;--tone:#2563eb"><div class="stat-head"><span class="stat-label">Utilisateurs</span><span class="stat-icon"><svg viewBox="0 0 24 24" fill="none"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8M22 21v-2a4 4 0 0 0-3-3.87" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span></div><div class="stat-value"><%= stats.totalUsers.toLocaleString('fr-FR') %></div><div class="stat-meta"><%= stats.activeUsers.toLocaleString('fr-FR') %> comptes actifs</div></article>
    <article class="stat-card" style="--tint:#f5f3ff;--tone:#7c3aed"><div class="stat-head"><span class="stat-label">Organisations</span><span class="stat-icon"><svg viewBox="0 0 24 24" fill="none"><path d="M4 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16M16 9h2a2 2 0 0 1 2 2v10M8 7h4M8 11h4M2 21h20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span></div><div class="stat-value"><%= stats.totalOrganizations.toLocaleString('fr-FR') %></div><div class="stat-meta"><%= stats.activeOrganizations.toLocaleString('fr-FR') %> organisations actives</div></article>
    <article class="stat-card" style="--tint:#ecfdf5;--tone:#059669"><div class="stat-head"><span class="stat-label">Événements</span><span class="stat-icon"><svg viewBox="0 0 24 24" fill="none"><path d="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14H3V6a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span></div><div class="stat-value"><%= stats.totalEvents.toLocaleString('fr-FR') %></div><div class="stat-meta">Événements non archivés</div></article>
    <article class="stat-card" style="--tint:#fff7ed;--tone:#ea580c"><div class="stat-head"><span class="stat-label">Scans aujourd’hui</span><span class="stat-icon"><svg viewBox="0 0 24 24" fill="none"><path d="M3 9V5a2 2 0 0 1 2-2h4M15 3h4a2 2 0 0 1 2 2v4M21 15v4a2 2 0 0 1-2 2h-4M9 21H5a2 2 0 0 1-2-2v-4M8 12h8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span></div><div class="stat-value"><%= stats.scansToday.toLocaleString('fr-FR') %></div><div class="stat-meta">Depuis minuit, heure du serveur</div></article>
    <article class="stat-card" style="--tint:#f0fdfa;--tone:#0d9488"><div class="stat-head"><span class="stat-label">Activation utilisateurs</span><span class="stat-icon">%</span></div><div class="stat-value"><%= stats.totalUsers ? Math.round((stats.activeUsers / stats.totalUsers) * 100) : 0 %>%</div><div class="stat-meta">Part des comptes actifs</div></article>
    <article class="stat-card" style="--tint:#f1f5f9;--tone:#475569"><div class="stat-head"><span class="stat-label">Activation organisations</span><span class="stat-icon">%</span></div><div class="stat-value"><%= stats.totalOrganizations ? Math.round((stats.activeOrganizations / stats.totalOrganizations) * 100) : 0 %>%</div><div class="stat-meta">Part des organisations actives</div></article>
</section>
<section class="panel"><div class="panel-header"><div><h3>Accès rapide</h3><p>Gestion courante de la console</p></div></div><div class="quick-grid"><a href="/organizations" class="quick-card"><span class="stat-icon" style="--tint:#eff6ff;--tone:#2563eb">O</span><span><strong>Gérer les organisations</strong><span>Informations, plans et agents rattachés</span></span><span class="quick-arrow">→</span></a></div></section>
<%- include('partials/app-shell-end') %>
<%- include('partials/footer') %>
