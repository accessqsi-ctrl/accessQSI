<%- include('partials/header', { title: 'Finances' }) %>
<%- include('partials/app-shell-start', { currentPage: 'finance', pageTitle: 'Finances', pageDescription: 'Reversements aux organisateurs et remboursements des billets' }) %>
<%
const money = (amount, currency) => { try { return new Intl.NumberFormat('fr-FR', { style: 'currency', currency }).format(Number(amount)); } catch { return `${amount} ${currency}`; } };
const date = (value) => value ? new Date(value).toLocaleString('fr-FR') : '—';
const payoutBadge = { APPROVED: ['badge-blue', 'Validé, envoi en cours'], SUBMITTING: ['badge-blue', 'Envoi en cours'], PROCESSING: ['badge-blue', 'Chez l’opérateur'], COMPLETED: ['badge-green', 'Versé'], FAILED: ['badge-amber', 'Échoué, recrédité'], REJECTED: ['badge-slate', 'Refusé'], CANCELED: ['badge-slate', 'Annulé par l’organisateur'] };
const refundBadge = { PENDING: ['badge-blue', 'Envoi en cours'], PROCESSING: ['badge-blue', 'Chez l’opérateur'], COMPLETED: ['badge-green', 'Remboursé'], FAILED: ['badge-amber', 'Échoué'] };
%>
<section class="page-intro"><div><h2>Finances de la billetterie</h2><p>Les validations sont enregistrées ici ; le backend AccessQ envoie ensuite l’argent via pawaPay et vérifie le résultat.</p></div><span class="badge badge-blue"><%= requested.length %> reversement(s) à valider</span></section>
<% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %><% if (success) { %><div class="alert alert-success" role="status"><%= success %></div><% } %>

<section class="panel">
    <div class="panel-header"><div><h3>Nouveau reversement</h3><p>Saisissez vous-même le bénéficiaire. Sans organisation, le montant est prélevé sur le solde de la plateforme. Choisissez l’opérateur Mobile Money sur lequel le numéro est réellement enregistré (attention aux numéros portés) : c’est lui qui recevra l’envoi.</p></div></div>
    <form action="/finance/payouts" method="POST" class="manual-payout-form" data-manual-payout data-password-confirm data-confirm-title="Confirmer le reversement" data-confirm-template="{amount} {currency} vers {phone_number} ({provider}, {country}), prélevés sur : {org_id}. Saisissez votre mot de passe de super-admin pour valider la transaction." autocomplete="off">
        <input type="hidden" name="_csrf" value="<%= user.csrf %>">
        <label class="field"><span class="field-label">Prélevé sur</span>
            <select name="org_id" class="field-input">
                <option value="">Solde de la plateforme AccessQ</option>
                <% [...new Map(balances.map(row => [row.orgId, row])).values()].forEach(row => { %><option value="<%= row.orgId %>"><%= row.organizationName %> (<%= balances.filter(item => item.orgId === row.orgId).map(item => money(item.balance, item.currency)).join(' · ') %>)</option><% }) %>
            </select></label>
        <label class="field"><span class="field-label">Pays</span>
            <select name="country" required class="field-input" data-country-select>
                <% payoutCountries.forEach(country => { %><option value="<%= country.code %>" data-currencies="<%= country.currencies.join(',') %>" data-prefix="<%= country.prefix %>"><%= country.name %> (+<%= country.prefix %>)</option><% }) %>
            </select></label>
        <label class="field"><span class="field-label">Opérateur</span>
            <select name="provider" required class="field-input" data-provider-select>
                <option value="">Choisir l’opérateur…</option>
                <% payoutCountries.forEach(country => { country.providers.forEach(provider => { %><option value="<%= provider.code %>" data-country="<%= country.code %>"><%= provider.name %></option><% }) }) %>
            </select></label>
        <label class="field"><span class="field-label">Devise</span>
            <select name="currency" required class="field-input" data-currency-select>
                <% [...new Set(payoutCountries.flatMap(country => country.currencies))].forEach(currency => { %><option value="<%= currency %>"><%= currency %></option><% }) %>
            </select></label>
        <label class="field"><span class="field-label">Montant</span><input name="amount" required inputmode="decimal" pattern="\d{1,12}([.,]\d{1,2})?" class="field-input" placeholder="100.00"></label>
        <label class="field"><span class="field-label">Numéro du bénéficiaire</span><input name="phone_number" required inputmode="tel" autocomplete="off" class="field-input" placeholder="0991234567 ou +243991234567"></label>
        <label class="field field-wide"><span class="field-label">Motif</span><input name="note" required maxlength="500" class="field-input" placeholder="Ex. retrait des commissions, paiement d’un prestataire…"></label>
        <div class="field-actions"><button class="action-button success">Envoyer le reversement</button></div>
    </form>
</section>

<section class="panel">
    <div class="panel-header"><div><h3>Solde de la plateforme</h3><p>Le solde calculé vient de la base AccessQ et ne tient pas compte des frais pawaPay. Le solde réel part du wallet pawaPay, relevé toutes les 5 minutes : on en retire ce qui est dû aux organisateurs, les reversements pas encore envoyés et les achats à vérifier ou à rembourser. Un reversement de la plateforme ne peut pas dépasser le plus petit des deux.</p></div></div>
    <div class="table-wrap"><table class="data-table"><thead><tr><th>Devise</th><th>Calculé AccessQ</th><th>Wallet pawaPay</th><th>Dû aux organisateurs</th><th>En attente</th><th class="align-right">Réellement disponible</th><th class="align-right">Écart (frais…)</th></tr></thead><tbody>
    <% reconciliation.forEach(row => { const platform = platformBalances.find(item => item.currency === row.currency); %><tr>
        <td><strong><%= row.currency %></strong></td>
        <td><%= money(row.computed, row.currency) %><% if (platform) { %><div class="cell-subtitle">Abonnements <%= money(platform.subscriptions, row.currency) %> · commissions <%= money(platform.commissions, row.currency) %> · reversé <%= money(platform.payouts, row.currency) %></div><% } %></td>
        <td><% if (row.wallet === null) { %><span class="badge badge-slate">Aucun relevé</span><% } else { %><%= money(row.wallet, row.currency) %>
            <div class="cell-subtitle"><%= row.wallets.map(wallet => `${wallet.country}${wallet.provider ? ' ' + wallet.provider : ''} : ${money(wallet.balance, row.currency)}`).join(' · ') %></div>
            <% if (row.stale) { %><span class="badge badge-amber">Relevé du <%= date(row.fetchedAt) %></span><% } else { %><div class="cell-subtitle">Relevé le <%= date(row.fetchedAt) %></div><% } %><% } %></td>
        <td><%= money(row.owedToOrganizers, row.currency) %></td>
        <td><%= money(row.pendingPayouts.plus(row.reservedPayments), row.currency) %><div class="cell-subtitle">Reversements <%= money(row.pendingPayouts, row.currency) %> · achats <%= money(row.reservedPayments, row.currency) %></div></td>
        <td class="align-right"><strong><%= row.available === null ? '—' : money(row.available, row.currency) %></strong></td>
        <td class="align-right"><% if (row.gap === null) { %>—<% } else { %><span class="badge <%= row.gap.lt(0) ? 'badge-amber' : 'badge-slate' %>"><%= row.gap.gt(0) ? '+' : '' %><%= money(row.gap, row.currency) %></span><% } %></td>
    </tr><% }) %>
    <% if (!reconciliation.length) { %><tr><td colspan="7" class="empty-state">Aucun encaissement pour l’instant.</td></tr><% } %>
    </tbody></table></div>
</section>

<section class="panel">
    <div class="panel-header"><div><h3>Reversements à valider</h3><p>Le montant est déjà retiré du solde de l’organisateur. Un refus le lui rend.</p></div></div>
    <div class="table-wrap"><table class="data-table"><thead><tr><th>Organisation</th><th>Montant</th><th>Destination</th><th>Demandé par</th><th class="align-right">Décision</th></tr></thead><tbody>
    <% requested.forEach(payout => { %><tr>
        <td><a class="entity-link" href="/organizations/<%= payout.org_id %>"><%= payout.organization.name %></a><div class="cell-subtitle">le <%= date(payout.created_at) %></div></td>
        <td><strong><%= money(payout.amount, payout.currency) %></strong></td>
        <td><%= payout.provider %><div class="cell-subtitle"><%= payout.phone_number %> · <%= payout.country %></div>
            <% if (payout.accountRecentlyChanged) { %><span class="badge badge-amber">Compte modifié le <%= date(payout.accountUpdatedAt) %></span><% } %></td>
        <td><%= payout.requested_by.full_name %><div class="cell-subtitle"><%= payout.requested_by.email %></div></td>
        <td class="align-right"><div class="action-row">
            <form action="/finance/payouts/<%= payout.payout_id %>/approve" method="POST" data-password-confirm data-confirm-title="Valider le reversement" data-confirm-message="<%= `${money(payout.amount, payout.currency)} vers ${payout.phone_number}. Saisissez votre mot de passe de super-admin.` %>" autocomplete="off">
                <input type="hidden" name="_csrf" value="<%= user.csrf %>"><button class="action-button success">Valider</button>
            </form>
            <form action="/finance/payouts/<%= payout.payout_id %>/reject" method="POST" class="action-row" data-password-confirm data-confirm-title="Refuser le reversement" data-confirm-message="Le montant reviendra sur le solde de l’organisateur. Saisissez votre mot de passe de super-admin." autocomplete="off">
                <input type="hidden" name="_csrf" value="<%= user.csrf %>"><input name="reason" required maxlength="500" placeholder="Motif du refus" class="field-input"><button class="action-button warning">Refuser</button>
            </form>
        </div></td>
    </tr><% }) %>
    <% if (!requested.length) { %><tr><td colspan="5" class="empty-state">Aucun reversement en attente.</td></tr><% } %>
    </tbody></table></div>
</section>

<section class="panel">
    <div class="panel-header"><div><h3>Soldes des organisateurs</h3><p>Reversez un solde sans attendre la demande de l’organisateur. L’argent part uniquement vers le compte de réception qu’il a enregistré.</p></div><span class="badge badge-blue"><%= balances.length %></span></div>
    <div class="table-wrap"><table class="data-table"><thead><tr><th>Organisation</th><th>Solde disponible</th><th>Compte de réception</th><th class="align-right">Reverser</th></tr></thead><tbody>
    <% balances.forEach(row => { %><tr>
        <td><a class="entity-link" href="/organizations/<%= row.orgId %>"><%= row.organizationName %></a></td>
        <td><strong><%= money(row.balance, row.currency) %></strong></td>
        <td><% if (row.account) { %><%= row.account.provider %><div class="cell-subtitle"><%= row.account.phone_number %> · <%= row.account.country %></div><% if (row.accountRecentlyChanged) { %><span class="badge badge-amber">Compte modifié le <%= date(row.account.updated_at) %></span><% } %><% } else { %><span class="badge badge-slate">Aucun compte enregistré</span><% } %></td>
        <td class="align-right">
            <% if (!row.account) { %><span class="action-note">L’organisateur doit enregistrer un compte</span>
            <% } else if (row.payoutInProgress) { %><span class="action-note">Reversement déjà en cours</span>
            <% } else { %>
            <form action="/finance/organizations/<%= row.orgId %>/payouts" method="POST" class="action-row" data-password-confirm data-confirm-title="Confirmer le reversement" data-confirm-message="<%= `Le montant sera envoyé à ${row.account.phone_number} (${row.account.provider}). Saisissez votre mot de passe de super-admin pour valider la transaction.` %>" autocomplete="off">
                <input type="hidden" name="_csrf" value="<%= user.csrf %>"><input type="hidden" name="currency" value="<%= row.currency %>">
                <input name="amount" inputmode="decimal" placeholder="<%= `${row.balance} (tout)` %>" class="field-input" aria-label="Montant à reverser">
                <button class="action-button success">Reverser</button>
            </form>
            <% } %>
        </td>
    </tr><% }) %>
    <% if (!balances.length) { %><tr><td colspan="4" class="empty-state">Aucun solde à reverser.</td></tr><% } %>
    </tbody></table></div>
</section>

<section class="panel">
    <div class="panel-header"><div><h3>Paiements à vérifier</h3><p>Paiement reçu sans billet émis : montant incohérent, ou offre complète au moment de la confirmation. Le remboursement est envoyé au numéro qui a payé.</p></div><span class="badge badge-amber"><%= reviewPayments.length %></span></div>
    <div class="table-wrap"><table class="data-table"><thead><tr><th>Acheteur</th><th>Organisation · offre</th><th>Montant</th><th>Motif</th><th class="align-right">Action</th></tr></thead><tbody>
    <% reviewPayments.forEach(payment => { %><tr>
        <td><%= payment.attendee.full_name %><div class="cell-subtitle"><%= payment.attendee.email %> · <%= payment.phone_number %></div></td>
        <td><%= payment.organization.name %><div class="cell-subtitle"><%= payment.offer.name %></div></td>
        <td><strong><%= money(payment.amount, payment.currency) %></strong><div class="cell-subtitle"><%= date(payment.completed_at) %></div></td>
        <td><%= payment.failure_code || '—' %><% if (payment.refund?.status === 'FAILED') { %><div class="cell-subtitle">Remboursement précédent échoué : <%= payment.refund.failure_code %></div><% } %></td>
        <td class="align-right">
            <form action="/finance/ticket-payments/<%= payment.ticket_payment_id %>/refund" method="POST" class="action-row" data-password-confirm data-confirm-title="Rembourser l’acheteur" data-confirm-message="<%= `${money(payment.amount, payment.currency)} seront renvoyés à ${payment.phone_number}. Saisissez votre mot de passe de super-admin.` %>" autocomplete="off">
                <input type="hidden" name="_csrf" value="<%= user.csrf %>"><input name="reason" required maxlength="500" placeholder="Motif" class="field-input"><button class="action-button danger">Rembourser</button>
            </form>
        </td>
    </tr><% }) %>
    <% if (!reviewPayments.length) { %><tr><td colspan="5" class="empty-state">Aucun paiement à vérifier.</td></tr><% } %>
    </tbody></table></div>
</section>

<section class="detail-grid">
    <article class="panel">
        <div class="panel-header"><div><h3>Derniers reversements</h3></div></div>
        <div class="table-wrap"><table class="data-table"><thead><tr><th>Source</th><th>Montant</th><th>État</th></tr></thead><tbody>
        <% recentPayouts.forEach(payout => { const [tone, label] = payoutBadge[payout.status] || ['badge-slate', payout.status]; %><tr>
            <td><%= payout.organization ? payout.organization.name : 'Plateforme AccessQ' %><div class="cell-subtitle"><%= date(payout.updated_at) %></div>
                <% if (payout.manual_recipient) { %><div class="cell-subtitle">Saisi par <%= payout.requested_by.full_name %><% if (payout.note) { %> · <%= payout.note %><% } %></div><% } %></td>
            <td><%= money(payout.amount, payout.currency) %><div class="cell-subtitle">+<%= payout.phone_number %> · <%= payout.provider || 'opérateur en détection' %></div></td>
            <td><span class="badge <%= tone %>"><%= label %></span><% if (payout.failure_code) { %><div class="cell-subtitle"><%= payout.failure_code %><% if (payout.failure_message && payout.failure_message !== payout.failure_code) { %> : <%= payout.failure_message %><% } %></div><% } %></td>
        </tr><% }) %>
        <% if (!recentPayouts.length) { %><tr><td colspan="3" class="empty-state">Aucun reversement.</td></tr><% } %>
        </tbody></table></div>
    </article>
    <article class="panel">
        <div class="panel-header"><div><h3>Derniers remboursements</h3></div></div>
        <div class="table-wrap"><table class="data-table"><thead><tr><th>Acheteur</th><th>Montant</th><th>État</th></tr></thead><tbody>
        <% recentRefunds.forEach(refund => { const [tone, label] = refundBadge[refund.status] || ['badge-slate', refund.status]; %><tr>
            <td><%= refund.ticket_payment.attendee.full_name %><div class="cell-subtitle"><%= refund.ticket_payment.organization.name %> · <%= refund.reason %></div></td>
            <td><%= money(refund.ticket_payment.amount, refund.ticket_payment.currency) %></td>
            <td><span class="badge <%= tone %>"><%= label %></span></td>
        </tr><% }) %>
        <% if (!recentRefunds.length) { %><tr><td colspan="3" class="empty-state">Aucun remboursement.</td></tr><% } %>
        </tbody></table></div>
    </article>
</section>
<%- include('partials/app-shell-end') %><%- include('partials/footer') %>
