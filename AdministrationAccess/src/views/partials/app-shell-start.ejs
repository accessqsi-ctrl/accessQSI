<div class="admin-shell">
    <div id="mobile-overlay" class="mobile-overlay" aria-hidden="true"></div>
    <aside id="admin-sidebar" class="admin-sidebar" aria-label="Navigation principale">
        <div class="brand-block">
            <a href="/dashboard" class="brand-link" aria-label="Accueil AccessQ Admin">
                <span class="brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M7 3h7l4 4v4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M17 14a5 5 0 1 1-2-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="m16 15 1.8 1.8L21 13.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                <span><strong class="brand-name">AccessQ</strong><small class="brand-role">Administration</small></span>
            </a>
            <button type="button" class="sidebar-close" data-close-menu aria-label="Fermer le menu"><svg viewBox="0 0 24 24" fill="none"><path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
        </div>
        <nav class="sidebar-nav">
            <p class="nav-label">Pilotage</p>
            <a href="/dashboard" class="nav-item <%= currentPage === 'dashboard' ? 'is-active' : '' %>"><svg viewBox="0 0 24 24" fill="none"><path d="M3 11 12 3l9 8M5 10v10h14V10M9 20v-6h6v6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Tableau de bord</span></a>
            <a href="/organizations" class="nav-item <%= currentPage === 'organizations' ? 'is-active' : '' %>"><svg viewBox="0 0 24 24" fill="none"><path d="M4 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16M16 9h2a2 2 0 0 1 2 2v10M8 7h4M8 11h4M8 15h4M2 21h20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Organisations</span></a>
            <a href="/users" class="nav-item <%= currentPage === 'users' ? 'is-active' : '' %>"><svg viewBox="0 0 24 24" fill="none"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg><span>Agents</span></a>
        </nav>
        <div class="sidebar-account">
            <div class="account-avatar"><%= (user.email || 'A').charAt(0).toUpperCase() %></div>
            <div class="account-copy"><strong>Super-admin</strong><span><%= user.email %></span></div>
            <form action="/logout" method="POST"><input type="hidden" name="_csrf" value="<%= user.csrf %>"><button type="submit" class="logout-button" aria-label="Se déconnecter" title="Se déconnecter"><svg viewBox="0 0 24 24" fill="none"><path d="M10 17l5-5-5-5M15 12H3M14 3h5a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button></form>
        </div>
    </aside>
    <section class="admin-stage">
        <header class="admin-topbar">
            <button type="button" class="menu-button" data-open-menu aria-controls="admin-sidebar" aria-expanded="false" aria-label="Ouvrir le menu"><svg viewBox="0 0 24 24" fill="none"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
            <div><h1><%= pageTitle %></h1><p><%= pageDescription %></p></div>
            <span class="environment-badge">Console centrale</span>
        </header>
        <main class="admin-main">
