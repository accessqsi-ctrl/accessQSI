generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserQ {
  user_id            Int           @id @default(autoincrement())
  clef               String        @unique
  full_name          String
  email              String        @unique
  password_hash      String
  role               Role
  is_verified        Boolean       @default(false)
  is_active          Boolean       @default(true)
  suspended_by_plan  Boolean       @default(false)
  verification_token String?       @unique
  deleted_at         DateTime?
  created_at         DateTime      @default(now())
  last_login         DateTime?
  org_id             Int?
  scan_logs          ScanLog[]
  organization       Organization? @relation(fields: [org_id], references: [org_id])
  payments           Payment[]

  @@map("usersQ")
}

model Organization {
  org_id                        Int                    @id @default(autoincrement())
  name                          String
  created_at                    DateTime               @default(now())
  deleted_at                    DateTime?
  is_active                     Boolean                @default(true)
  subscription_plan             Int?
  subscription_started_at       DateTime?
  subscription_expires_at       DateTime?
  subscription_interval         BillingInterval?
  trial_started_at              DateTime?
  trial_expires_at              DateTime?
  enterprise_contract_reference String?
  enterprise_entitlements       Json?
  areas                         Area[]
  events                        Event[]
  plan                          Plan?                  @relation(fields: [subscription_plan], references: [plan_id])
  payments                      Payment[]
  subscription                  Subscription?
  subscription_periods          SubscriptionPeriod[]
  subscription_audit_logs       SubscriptionAuditLog[]
  usersQ                        UserQ[]

  @@map("organizations")
}

model Event {
  event_id       Int             @id @default(autoincrement())
  org_id         Int
  title          String
  description    String?
  created_at     DateTime        @default(now())
  deleted_at     DateTime?
  EventSchedules EventSchedule[]
  organization   Organization    @relation(fields: [org_id], references: [org_id])
  qr_codes       QrCode[]

  @@map("events")
}

model QrCode {
  qr_id        Int       @id @default(autoincrement())
  event_id     Int
  unique_token String    @unique
  status       QrStatus
  usage_limit  Int       @default(1)
  scans_count  Int       @default(0)
  valid_from   DateTime?
  valid_until  DateTime?
  deleted_at   DateTime?
  level        Int?
  holder_name  String?
  holder_email String?
  holder_phone String?
  event        Event     @relation(fields: [event_id], references: [event_id])
  scan_logs    ScanLog[]

  @@map("qr_codes")
}

model ScanLog {
  id            Int        @id @default(autoincrement())
  qr_code_id    Int
  scanned_by_id Int
  scanned_at    DateTime   @default(now())
  location_lat  Decimal?
  location_long Decimal?
  status        ScanStatus
  qr_code       QrCode     @relation(fields: [qr_code_id], references: [qr_id])
  scanned_by    UserQ      @relation(fields: [scanned_by_id], references: [user_id])

  @@map("scan_logs")
}

model Area {
  area_id             Int             @id @default(autoincrement())
  org_id              Int
  area_name           String
  accreditation_level Int
  deleted_at          DateTime?
  suspended_by_plan   Boolean         @default(false)
  EventSchedules      EventSchedule[]
  organization        Organization    @relation(fields: [org_id], references: [org_id])

  @@map("area")
}

model Plan {
  plan_id       Int                  @id @default(autoincrement())
  title         String
  cost          Int
  currency      String               @default("USD") @db.VarChar(3)
  features      Json
  organizations Organization[]
  payments      Payment[]
  subscriptions Subscription[]       @relation("SubscriptionPlan")
  periods       SubscriptionPeriod[] @relation("SubscriptionPeriodPlan")

  @@map("plan")
}

model Payment {
  payment_id              Int           @id @default(autoincrement())
  deposit_id              String        @unique @db.Uuid
  org_id                  Int
  plan_id                 Int
  initiated_by_id         Int
  amount                  Decimal       @db.Decimal(18, 2)
  currency                String        @db.VarChar(3)
  reference_amount        Decimal       @db.Decimal(18, 2)
  reference_currency      String        @default("USD") @db.VarChar(3)
  country                 String        @db.VarChar(3)
  provider                String
  phone_number            String
  status                  PaymentStatus @default(PENDING)
  provider_transaction_id String?
  failure_code            String?
  failure_message         String?
  access_starts_at        DateTime?
  access_expires_at       DateTime?
  provider_payload        Json?
  created_at              DateTime      @default(now())
  updated_at              DateTime      @updatedAt
  completed_at            DateTime?
  organization            Organization  @relation(fields: [org_id], references: [org_id])
  plan                    Plan          @relation(fields: [plan_id], references: [plan_id])
  initiated_by            UserQ         @relation(fields: [initiated_by_id], references: [user_id])

  @@index([org_id, created_at])
  @@index([org_id, status])
  @@index([initiated_by_id])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
  REFUND_PENDING
  REFUNDED
  REVIEW_REQUIRED
}

model Subscription {
  subscription_id      Int                @id @default(autoincrement())
  org_id               Int                @unique
  plan_id              Int
  status               SubscriptionStatus @default(ACTIVE)
  billing_interval     BillingInterval?
  current_period_start DateTime?
  current_period_end   DateTime?
  cancel_at_period_end Boolean            @default(false)
  version              Int                @default(1)
  created_at           DateTime           @default(now())
  updated_at           DateTime           @updatedAt
  organization         Organization       @relation(fields: [org_id], references: [org_id])
  plan                 Plan               @relation("SubscriptionPlan", fields: [plan_id], references: [plan_id])

  @@map("subscriptions")
}

model SubscriptionPeriod {
  subscription_period_id Int              @id @default(autoincrement())
  org_id                 Int
  plan_id                Int
  payment_id             Int?
  billing_interval       BillingInterval?
  starts_at              DateTime
  ends_at                DateTime?
  source                 String
  entitlement_snapshot   Json
  created_at             DateTime         @default(now())
  organization           Organization     @relation(fields: [org_id], references: [org_id])
  plan                   Plan             @relation("SubscriptionPeriodPlan", fields: [plan_id], references: [plan_id])

  @@map("subscription_periods")
}

model SubscriptionAuditLog {
  subscription_audit_log_id Int          @id @default(autoincrement())
  org_id                    Int
  actor_user_id             Int?
  action                    String
  before_snapshot           Json?
  after_snapshot            Json?
  created_at                DateTime     @default(now())
  organization              Organization @relation(fields: [org_id], references: [org_id])

  @@map("subscription_audit_logs")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  CANCELED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  ANNUAL
  ONE_TIME
}

model EventSchedule {
  id         Int      @id @default(autoincrement())
  id_event   Int
  id_area    Int
  start_date DateTime
  end_date   DateTime
  area       Area     @relation(fields: [id_area], references: [area_id])
  event      Event    @relation(fields: [id_event], references: [event_id])

  @@map("EventSchedule")
}

enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  ORG_AGENT
  OPERATOR
}

enum QrStatus {
  active
  revoked
  expired
  used_up
}

enum ScanStatus {
  authorized
  denied_expired
  denied_revoked
  denied_limit_reached
}
