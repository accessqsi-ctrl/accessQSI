generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserQ {
  user_id            Int           @id @default(autoincrement())
  clef               String        @unique
  full_name          String
  email              String        @unique
  password_hash      String
  role               Role
  is_verified        Boolean       @default(false)
  is_active          Boolean       @default(true)
  verification_token String?       @unique
  deleted_at         DateTime?
  created_at         DateTime      @default(now())
  last_login         DateTime?
  org_id             Int?
  scan_logs          ScanLog[]
  organization       Organization? @relation(fields: [org_id], references: [org_id])

  @@index([org_id, deleted_at])
  @@index([role])
  @@map("usersQ")
}

model Organization {
  org_id            Int       @id @default(autoincrement())
  name              String
  created_at        DateTime  @default(now())
  deleted_at        DateTime?
  is_active         Boolean   @default(true)
  subscription_plan Int?
  default_card_template_id String?
  areas             Area[]
  card_templates    CardTemplateCustom[]
  events            Event[]
  plan              Plan?     @relation(fields: [subscription_plan], references: [plan_id])
  usersQ            UserQ[]

  @@index([deleted_at])
  @@map("organizations")
}

model CardTemplateCustom {
  id                   Int          @id @default(autoincrement())
  org_id               Int
  base_template_id     String
  name                 String
  primary_color        String
  secondary_color      String
  title                String
  card_message_default String?
  logo_url             String?
  qr_position          String
  visible_fields       Json
  layout               String
  is_default           Boolean      @default(false)
  deleted_at           DateTime?
  created_at           DateTime     @default(now())
  updated_at           DateTime     @updatedAt
  organization         Organization @relation(fields: [org_id], references: [org_id])

  @@index([org_id, deleted_at])
  @@index([org_id, is_default])
  @@map("card_template_customs")
}

model Event {
  event_id       Int             @id @default(autoincrement())
  org_id         Int
  title          String
  description    String?
  created_at     DateTime        @default(now())
  deleted_at     DateTime?
  EventSchedules EventSchedule[]
  organization   Organization    @relation(fields: [org_id], references: [org_id])
  qr_codes       QrCode[]

  @@index([org_id, deleted_at])
  @@map("events")
}

model QrCode {
  qr_id        Int       @id @default(autoincrement())
  event_id     Int
  unique_token String    @unique
  status       QrStatus
  usage_limit  Int       @default(1)
  scans_count  Int       @default(0)
  valid_from   DateTime?
  valid_until  DateTime?
  deleted_at   DateTime?
  level        Int?
  holder_name  String?
  holder_email String?
  holder_phone String?
  event        Event     @relation(fields: [event_id], references: [event_id])
  scan_logs    ScanLog[]

  @@index([event_id, status, deleted_at])
  @@map("qr_codes")
}

model ScanLog {
  id            Int        @id @default(autoincrement())
  qr_code_id    Int
  scanned_by_id Int
  scanned_at    DateTime   @default(now())
  location_lat  Decimal?
  location_long Decimal?
  status        ScanStatus
  qr_code       QrCode     @relation(fields: [qr_code_id], references: [qr_id])
  scanned_by    UserQ      @relation(fields: [scanned_by_id], references: [user_id])

  @@index([qr_code_id])
  @@index([scanned_by_id])
  @@index([scanned_at])
  @@map("scan_logs")
}

model Area {
  area_id             Int             @id @default(autoincrement())
  org_id              Int
  area_name           String
  accreditation_level Int
  deleted_at          DateTime?
  EventSchedules      EventSchedule[]
  organization        Organization    @relation(fields: [org_id], references: [org_id])

  @@index([org_id, deleted_at])
  @@map("area")
}

model Plan {
  plan_id       Int            @id @default(autoincrement())
  title         String
  cost          Int
  features      Json
  organizations Organization[]

  @@map("plan")
}

model EventSchedule {
  id         Int      @id @default(autoincrement())
  id_event   Int
  id_area    Int
  start_date DateTime
  end_date   DateTime
  area       Area     @relation(fields: [id_area], references: [area_id])
  event      Event    @relation(fields: [id_event], references: [event_id])

  @@index([id_event])
  @@index([id_area])
  @@map("EventSchedule")
}

enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  ORG_AGENT
  OPERATOR
}

enum QrStatus {
  active
  revoked
  expired
  used_up
}

enum ScanStatus {
  authorized
  denied_expired
  denied_revoked
  denied_limit_reached
}
