NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/accessqsi

FRONTEND_URL=http://localhost:3000
TRUST_PROXY=false

PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----"
PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----"
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
SALT_ROUNDS=10

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace@example.com
SMTP_PASS=replace-me
SMTP_FROM="QR Access <no-reply@example.com>"
