NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/accessqsi

FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:4000
CORS_ORIGINS=
TRUST_PROXY=false
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
LOG_LEVEL=debug
LOG_REQUESTS=false
SLOW_REQUEST_MS=1000
GENERAL_RATE_LIMIT_MAX=1000

# Stockage local (développement ou serveur avec disque persistant).
STORAGE_DRIVER=local
FILE_STORAGE_ROOT=src/statics

# Sur Render gratuit, utilisez R2 et laissez FILE_STORAGE_ROOT inutilisé.
# R2_PUBLIC_URL est le domaine public r2.dev ou un domaine personnalisé du bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=accessq-assets
R2_PUBLIC_URL=
# Facultatif : https://<ACCOUNT_ID>.r2.cloudflarestorage.com est utilisé par défaut.
R2_ENDPOINT=

# Recommandé : fichiers PEM locaux (ignorés par Git).
PRIVATE_KEY_PATH=private.pem
PUBLIC_KEY_PATH=public.pem
# Alternative pour les plateformes cloud : contenu PEM sur une seule ligne avec \n.
PRIVATE_KEY=
PUBLIC_KEY=
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
SALT_ROUNDS=10

BREVO_API_KEY=replace-me
BREVO_SENDER_NAME=AccessQ
BREVO_SENDER_EMAIL=replace@example.com

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace@example.com
SMTP_PASS=replace-me
SMTP_FROM="AccessQ <no-reply@example.com>"

# Paiements Mobile Money pawaPay (sandbox par défaut)
# Laissez à false tant que la configuration et les tests de paiement ne sont pas terminés.
PRO_PAYMENTS_ENABLED=false
PAWAPAY_ENVIRONMENT=sandbox
PAWAPAY_API_TOKEN=
# Laissez vide pour utiliser l'URL officielle correspondant à l'environnement.
PAWAPAY_BASE_URL=
PAWAPAY_TIMEOUT_MS=15000
PAWAPAY_COUNTRY=
PAWAPAY_CURRENCY=USD
# Facultatif : limite les opérateurs proposés, séparés par des virgules.
PAWAPAY_PROVIDERS=
PAWAPAY_CUSTOMER_MESSAGE=ACCESSQ PRO

# Billetterie payante (même compte pawaPay, indépendante des abonnements Pro)
TICKET_PAYMENTS_ENABLED=false
# Commission de la plateforme par défaut, en pourcentage. Réglable par organisation depuis la console d'administration.
TICKET_COMMISSION_PERCENT=10
# Durée de réservation d'une place pendant le paiement (5 à 60 minutes).
TICKET_PAYMENT_HOLD_MINUTES=15

# Durée de l'essai Pro individuel (entre 1 et 90 jours, 30 par défaut)
PRO_TRIAL_DURATION_DAYS=30
PRO_SUBSCRIPTION_DAYS=30

# Formulaires d'inscription publics (liens partageables). Masqués tant que la valeur n'est pas true.
REGISTRATION_FORMS_ENABLED=false

# Fuseau horaire de repli pour les limites par période (jour/semaine/mois) quand le navigateur
# de l'administrateur ne fournit pas le sien. Exemple : Africa/Kinshasa.
DEFAULT_TIMEZONE=UTC
